# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustgate_db

# Google Gemini API SDK (for optional semantic security heuristics)
GEMINI_API_KEY=your_gemini_api_key_here

# Security Gateway Configuration
GATEWAY_SECRET_KEY=9f8e7d6c5b4a39281706f5e4d3c2b1a0e9f8d7c6b5a4938271605f4e3d2c1b0a
ENFORCE_STORAGE_ENCRYPTION=false
DEFAULT_CLIENT_RATE_LIMIT=100

# Supabase Credentials (Cloud Telemetry & Merkle Audit Logs)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
